# HTTPS automático.
#
# O Caddy pede o certificado ao Let's Encrypt sozinho, renova sozinho, e
# redireciona HTTP para HTTPS sem configuração. É por isso que ele está aqui em
# vez de Nginx: a alternativa seria certbot, cron de renovação e um bloco de
# configuração de vinte linhas que quebra calado quando o certificado vence.
#
# Login por HTTP é senha trafegando aberta, e este sistema vai ter CNH, CPF e
# contrato de 166 pessoas atrás dele.

{$DOMINIO} {
	reverse_proxy site:3000

	# Comprime só uma lista fechada de tipos, e nunca `text/*` inteiro: o mapa
	# "Em campo" recebe as posições ao vivo em `text/event-stream`, e a
	# compressão seguraria os bytes até juntar um bloco — a posição chegaria em
	# rajadas, minutos atrasada, e o mapa pareceria travado.
	encode gzip {
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/plain*
			header Content-Type text/javascript*
			header Content-Type text/x-component*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type application/xml*
			header Content-Type image/svg+xml*
		}
	}

	# Cabeçalhos que custam nada e fecham buracos conhecidos.
	header {
		# Só HTTPS, por um ano, inclusive em subdomínio.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Navegador não adivinha o tipo do arquivo — o proxy de download entrega
		# PDF e imagem de cliente, e adivinhação vira execução de script.
		X-Content-Type-Options "nosniff"
		# Ninguém embute o Selebi num iframe de outro site.
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Não anuncia qual servidor é.
		-Server
	}

	log {
		output file /data/acesso.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
