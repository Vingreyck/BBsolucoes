# Copie para .env e preencha. O .env NÃO vai pro git.

DATABASE_URL="postgresql://postgres:postgres@localhost:5434/bbsolucoes"

# Chave usada para cifrar as credenciais de portal antes de gravar no banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""

# Conta Growatt OSS (somente leitura). Preencha na sua máquina — nunca commite.
GROWATT_USER=""
GROWATT_PASSWORD=""

# Token da OpenAPI v1 da Growatt, quando o distribuidor liberar.
# Enquanto não vier, o coletor usa a sessão de login acima.
GROWATT_API_TOKEN=""

# Rastreamento em campo: o servidor que cola a trilha nas ruas. Vazio = o OSRM
# público (grátis, 10 pontos por chamada). OSRM_ATIVO=false desliga a colagem.
OSRM_URL=""
OSRM_ATIVO=""

# WhatsApp Cloud API (fase 2, deixe vazio por enquanto)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# Opcional: força um host da Growatt. Vazio = o cliente varre os candidatos.
GROWATT_BASE_URL=""

# Chave da Open API da FoxESS. Sai no FoxCloud OpenPlatform, em API Keys.
# Aparece em texto claro uma unica vez: copie sem trocar de tela.
FOXESS_API_KEY=""

# Conta northbound do FusionSolar (Huawei). NAO e o login do site: e uma conta
# a parte, criada em System > Company Management > Northbound Management.
# O systemCode faz o papel de senha.
FUSIONSOLAR_USUARIO=""
FUSIONSOLAR_SYSTEM_CODE=""
# Servidor da regiao. Cada servidor do FusionSolar e um banco separado, e uma
# conta so existe em um deles — as usinas da BB estao no intl. Descubra o certo
# pela barra de endereco de QUEM ENXERGA as usinas, nao pelo servidor onde a
# conta de API foi criada. Ha tambem eu5, la5, au5.
FUSIONSOLAR_BASE_URL="https://intl.fusionsolar.huawei.com"

# SolisCloud. No painel do portal os campos aparecem como KeyID, KeySecret e
# API URL — o ultimo tem espaco no nome e nao serve como variavel.
#
# A BB tem MAIS DE UMA conta Solis, cada uma com sua chave. A partir da segunda,
# numere: SOLIS_KEY_ID_2, SOLIS_KEY_ID_3... O coletor para no primeiro buraco,
# entao nao pule numeros.
SOLIS_KEY_ID=""
SOLIS_KEY_SECRET=""
SOLIS_KEY_ID_2=""
SOLIS_KEY_SECRET_2=""
SOLIS_BASE_URL="https://www.soliscloud.com:13333"

# --------------------------------------------------------------------------
# Google Drive — Selebi como porta de entrada, Drive como depósito invisível
# --------------------------------------------------------------------------
# UMA conexão, da empresa, não uma por usuário: ninguém da equipe precisa de
# conta no Google. O Selebi age como a conta bbsolucoesengenharia ao criar
# pasta, gravar arquivo e devolver arquivo para quem pedir.
#
# Como obter, uma vez só: leia o cabeçalho de
# src/documentos/autorizar-drive.ts (seis passos no console do Google) e
# depois rode `npm run drive:autorizar`.
#
# O refresh token não expira e dá acesso ao Drive inteiro da empresa. Guarde
# como guarda senha — e nunca cole em conversa, ticket ou commit.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Id da pasta "Energia solar", que contém CLIENTES 2024, 2025 e 2026.
# É o mesmo valor de PASTA_RAIZ em scripts/listar-drive.gs.
GOOGLE_DRIVE_RAIZ=1D0WR5QREFHXBb4EH1Leoc15y3hX8Czd1
