# O robô do portal de projetos da Energisa (src/energisa/robo.ts).
#
# Imagem oficial do Playwright, na mesma versão do `playwright-core` do
# package.json — é ela que traz o Chromium e as bibliotecas que ele precisa.
# Separada da imagem do site para o site não carregar um navegador inteiro.
FROM mcr.microsoft.com/playwright:v1.49.1-noble

ENV TZ=America/Sao_Paulo

WORKDIR /app

COPY package.json package-lock.json* ./
# Com as dependências de desenvolvimento: o robô roda pelo `tsx`.
RUN npm ci --include=dev

COPY . .

CMD ["npx", "tsx", "src/energisa/robo.ts"]
